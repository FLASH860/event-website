# Loaded ONLY by `npm run dev`. No secrets here. Turns on the in-browser MOCK auth (demo accounts) so the frontend
# can be built without the backend. Ignored by `npm run build`. To test against the real backend, set this to false
# and fill VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in .env.local.
VITE_DEV_MOCK_AUTH=true
