# Copy to .env.local and fill in. Never commit real values. Only the PUBLIC anon key goes here.
# NEVER put a Supabase service-role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dev-only in-browser mock auth with demo accounts (already true in .env.development). Ignored in production builds.
VITE_DEV_MOCK_AUTH=false
# Dev-only layout preview without any auth.
VITE_DEV_PREVIEW=false
